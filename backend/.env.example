# Copy to .env and fill in real values. NEVER commit real secrets.
# DART (Korean OpenDART) API key. Issue/manage one at https://opendart.fss.or.kr
# (인증키 신청·관리). Leave blank here; set the real value only in .env (gitignored).
DART_API_KEY=
DART_BASE_URL=https://opendart.fss.or.kr/api
# LLM provider: any OpenAI-compatible chat-completions API. The default is Gemini;
# issue a free key at https://aistudio.google.com/apikey
# Leave blank here; set the real value only in .env (gitignored). The key travels
# only in the Authorization header. LLM_MODEL is configurable (exact name may change).
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-3.5-flash-lite
# SEC EDGAR requires a User-Agent that includes contact info (name + email).
SEC_BASE_URL=https://data.sec.gov
SEC_USER_AGENT=filing-digest/0.5.2 your-contact@example.com
DATABASE_URL=postgresql+psycopg://filing_digest:filing_digest_dev@localhost:5433/filing_digest
EMBEDDING_MODEL=nlpai-lab/KURE-v1
EMBEDDING_OFFLINE_FIRST=true
EMBEDDING_WARMUP_ENABLED=true

# JSON list; extend explicitly for an opted-in LAN client.
ALLOWED_HOSTS=["127.0.0.1","localhost","testserver"]
